# Copy to .env (gitignored) and fill in:
#   cp .env.example .env && chmod 600 .env

# Project the Cloud Run service, Artifact Registry repo and secret live in.
# Either an existing project, or the one `./deploy.sh project` creates.
WORKLOAD_PROJECT=my-herdr-project

# Project that hosts the Infra Manager deployments and the deployer service
# account. Defaults to WORKLOAD_PROJECT. Must be a different, existing project
# if you use `./deploy.sh project` to create WORKLOAD_PROJECT.
#INFRA_PROJECT=my-herdr-project

# Service account Infra Manager runs Terraform as (see infra/README.md).
DEPLOYER_SA=herdr-deployer@my-herdr-project.iam.gserviceaccount.com

# Region of the Cloud Run service and Artifact Registry repo.
REGION=us-central1

# Where Infra Manager keeps the deployment records (metadata only).
IM_LOCATION=us-central1

# Prefix for the two Infra Manager deployment names (<prefix>-project, <prefix>-service).
DEPLOYMENT_PREFIX=herdr-web

# Optional: a gcloud configuration to run everything under, so your default
# account/project are not touched. `gcloud config configurations create herdr`.
#GCLOUD_CONFIG=herdr
